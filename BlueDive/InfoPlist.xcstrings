    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Permission message shown when the app requests Bluetooth access to connect to a dive computer.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive nutzt Bluetooth, um eine Verbindung zu deinem Tauchcomputer herzustellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive uses Bluetooth to connect to your dive computer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BlueDive usa Bluetooth para conectarse a tu computadora de buceo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive utilise le Bluetooth pour se connecter à votre ordinateur de plongée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive bruker Bluetooth til å koble til dykkecomputeren din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive gebruikt Bluetooth om verbinding te maken met je duikcomputer."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Permission message shown when the app requests location access to display the user's position on the dive map.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BlueDive nutzt deinen Standort, um deine Position auf der Tauchkarte anzuzeigen und die Koordinaten von Tauchplätzen einzutragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive uses your location to show your position on the dive map and to fill in dive site coordinates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BlueDive usa tu ubicación para mostrar tu posición en el mapa de inmersiones y completar las coordenadas de los puntos de inmersión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BlueDive utilise votre position pour l'afficher sur la carte de plongée et pour remplir les coordonnées des sites de plongée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BlueDive bruker posisjonen din til å vise hvor du er på kartet og til å fylle inn koordinatene til dykkesteder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "BlueDive gebruikt je locatie om je positie op de duikkaart weer te geven en de coördinaten van duikstekken in te vullen."
          }
        }
      }
    },
