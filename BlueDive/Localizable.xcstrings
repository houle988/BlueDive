        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "* RMV utledet fra %1$@ + %2$@ ved hjelp av lagret arbeidstrykk for konvertering fra cu ft → L"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* AMV afgeleid van %1$@ + %2$@ met behulp van de opgeslagen werkdruk voor de omrekening van cu ft naar L"
          }
        }
      }
    },
    "* Some dives' RMV is calculated from units other than bar and litres." : {
      "comment" : "Footnote under an average RMV (trip details and the Statistics dashboard), explaining the * after the value: some of the dives were not recorded in bar and litres.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* Das AMV einiger Tauchgänge wird aus anderen Einheiten als bar und Liter berechnet."
