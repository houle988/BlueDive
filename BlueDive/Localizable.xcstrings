    "They were downloaded from your dive computer, then discarded because they were recorded before %@." : {
      "comment" : "Explanation in the Bluetooth sync results for dives discarded by the import cutoff date. %@ is the cutoff date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurden von deinem Tauchcomputer heruntergeladen und dann verworfen, weil sie vor dem %@ aufgezeichnet wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se descargaron de tu computadora de buceo y luego se descartaron porque se registraron antes del %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles ont été téléchargées depuis votre ordinateur de plongée, puis rejetées car elles ont été enregistrées avant le %@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De ble lastet ned fra dykkecomputeren og deretter forkastet fordi de ble registrert før %@."
