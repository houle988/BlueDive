    "Minimum Gas (MG) is the air you must keep in reserve to bring both you and your buddy safely to the surface if one of you runs out of air at depth." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mindestgas (MG) ist die Luftreserve, die du behalten musst, um dich und dein Tauchpartner sicher an die Oberfläche zu bringen, falls einer von euch in der Tiefe keine Luft mehr hat."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum Gas (MG) is the air you must keep in reserve to bring both you and your buddy safely to the surface if one of you runs out of air at depth."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El gas mínimo (MG) es el aire que debes conservar en reserva para llevarte a ti y a tu compañero a la superficie con seguridad si uno de los dos se queda sin aire en profundidad."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gaz minimum (GM) est la réserve d'air que vous devez conserver pour ramener vous et votre binôme en toute sécurité en surface si l'un de vous manque d'air en profondeur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Minimumsgass (MG) er luften du må ha i reserve for å bringe både deg og makkeren din trygt til overflaten hvis en av dere går tom for luft på dybden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minimum Gas (MG) is de hoeveelheid lucht die je in reserve moet houden om zowel jezelf als je buddy veilig naar de oppervlakte te brengen als een van jullie op diepte zonder lucht komt te zitten."
          }
        }
      }
    },
