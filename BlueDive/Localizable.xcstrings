    },
    "This looks like %1$@’s %2$@, last synced %3$@. Connect and update the Bluetooth pairing?" : {
      "comment" : "Reassociation alert message when a scanned device matches a known dive computer with a diver name. %1$@ = diver name, %2$@ = computer name, %3$@ = last sync date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das scheint das %2$@ von %1$@ zu sein, zuletzt synchronisiert am %3$@. Verbinden und Bluetooth-Kopplung aktualisieren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This looks like %1$@’s %2$@, last synced %3$@. Connect and update the Bluetooth pairing?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Parece ser la %2$@ de %1$@, sincronizada por última vez %3$@. ¿Conectar y actualizar el emparejamiento Bluetooth?"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela ressemble au %2$@ de %1$@, dernière synchronisation le %3$@. Se connecter et mettre à jour le jumelage Bluetooth ?"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dette ser ut som %2$@ til %1$@, sist synkronisert %3$@. Vil du koble til og oppdatere Bluetooth-sammenkoblingen?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit lijkt op %1$@’s %2$@, voor het laatst gesynchroniseerd op %3$@. Wil je de Bluetooth-koppeling herstellen en bijwerken?"
          }
        }
      }
    },
    "This looks like your %1$@ (serial …%2$@), last synced %3$@. Connect and update the Bluetooth pairing?" : {
