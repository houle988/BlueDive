    "* RMV calculated from %@ + %@ — only natively available in bar/L" : {
      "comment" : "Footnote explaining the * suffix on RMV when it was calculated from bar/L instead of the user's preferred unit.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* AMV berechnet aus %1$@ + %2$@ — nur nativ in bar/L verfügbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
