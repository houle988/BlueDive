    "The newest dives are fetched first. Stopping keeps the weather already fetched." : {
      "comment" : "A description of the behavior of the weather fetching process.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuesten Tauchgänge werden zuerst abgerufen. Beim Anhalten bleibt das bereits abgerufene Wetter erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las inmersiones más recientes se obtienen primero. Al detener se conserva el tiempo ya obtenido."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
