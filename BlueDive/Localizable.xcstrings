    },
    "The service pressure is used to convert the gas capacity (ft³) into actual water volume (L) for RMV and SAC calculations. Typical value: 3000 PSI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Betriebsdruck wird verwendet, um die Gaskapazität (ft³) für die RMV- und SAC-Berechnungen in das tatsächliche Wasservolumen (L) umzurechnen. Typischer Wert: 3000 PSI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service pressure is used to convert the gas capacity (ft³) into actual water volume (L) for RMV and SAC calculations. Typical value: 3000 PSI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La presión de servicio se usa para convertir la capacidad de gas (ft³) en el volumen de agua real (L) para los cálculos de RMV y SAC. Valor típico: 3000 PSI."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression de service est utilisée pour convertir la capacité de gaz (pi³) en volume d'eau réel (L) pour les calculs VRM et SAC. Valeur typique : 3 000 PSI."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Servicetrykket brukes til å konvertere gasskapasiteten (ft³) til faktisk vannvolum (L) for RMV- og SAC-beregninger. Typisk verdi: 3000 PSI."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De werkdruk wordt gebruikt om de gascapaciteit (ft³) om te rekenen naar het werkelijke watervolume (L) voor AMV- en SAC-berekeningen. Typische waarde: 3000 PSI."
          }
        }
      }
    },
    "The species could not be updated. Try again." : {
      "comment" : "iNaturalist lookup: the chosen taxon could not be saved on the species",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Art konnte nicht aktualisiert werden. Versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo actualizar la especie. Inténtalo de nuevo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espèce n’a pas pu être mise à jour. Réessayez."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arten kunne ikke oppdateres. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De soort kon niet worden bijgewerkt. Probeer het opnieuw."
          }
        }
      }
    },
    "The species is removed from the catalogue. Its sightings stay on their dives with the names they were recorded with, and its photos stay on their dives." : {
      "comment" : "The message in a confirmation alert that deletes a species.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Art wird aus dem Katalog entfernt. Ihre Sichtungen bleiben mit den erfassten Namen bei ihren Tauchgängen, und ihre Fotos bleiben bei ihren Tauchgängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La especie se elimina del catálogo. Sus avistamientos permanecen en sus inmersiones con los nombres con que se registraron, y sus fotos permanecen en sus inmersiones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espèce est retirée du catalogue. Ses observations restent sur leurs plongées avec les noms sous lesquels elles ont été enregistrées, et ses photos restent sur leurs plongées."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arten fjernes fra katalogen. Observasjonene blir værende på dykkene sine med navnene de ble registrert med, og bildene blir værende på dykkene sine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De soort wordt uit de catalogus verwijderd. De waarnemingen blijven bij hun duiken met de namen waaronder ze zijn vastgelegd, en de foto’s blijven bij hun duiken."
          }
        }
      }
    },
    "The stored copy has not been downloaded from iCloud yet, so it cannot be compared." : {
      "comment" : "Re-import question: why BlueDive asks",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherte Kopie wurde noch nicht aus iCloud heruntergeladen und kann daher nicht verglichen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La copia guardada aún no se ha descargado de iCloud, por lo que no se puede comparar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie enregistrée n’a pas encore été téléchargée d’iCloud et ne peut donc pas être comparée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Den lagrede kopien er ikke lastet ned fra iCloud ennå, så den kan ikke sammenlignes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opgeslagen kopie is nog niet uit iCloud gedownload en kan dus niet worden vergeleken."
          }
        }
      }
    },
    "The sync bookmark is saved even when no dive on the computer is newer than your date, so the next sync still fetches only genuinely new dives." : {
      "comment" : "A description of how the sync bookmark is saved and used.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Sync-Lesezeichen wird auch gespeichert, wenn kein Tauchgang auf dem Computer neuer als dein Datum ist, sodass die nächste Synchronisierung weiterhin nur wirklich neue Tauchgänge abruft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El marcador de sincronización se guarda incluso cuando ninguna inmersión de la computadora es posterior a tu fecha, de modo que la próxima sincronización sigue obteniendo solo las inmersiones realmente nuevas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le repère de synchronisation est enregistré même si aucune plongée de l'ordinateur n'est plus récente que votre date, de sorte que la prochaine synchronisation ne récupère toujours que les plongées réellement nouvelles."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniseringsbokmerket lagres selv om ingen dykk på computeren er nyere enn datoen din, slik at neste synkronisering fortsatt bare henter dykk som virkelig er nye."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatiebladwijzer wordt ook opgeslagen als geen enkele duik op de computer nieuwer is dan je datum, zodat de volgende synchronisatie nog steeds alleen echt nieuwe duiken ophaalt."
          }
        }
      }
    },
    "The sync stopped at the first dive recorded before %@ — older dives were not downloaded." : {
      "comment" : "Note in the Bluetooth sync results when the download ended at the user's import cutoff date, so older dives were never transferred. %@ is the cutoff date.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung endete beim ersten Tauchgang, der vor dem %@ aufgezeichnet wurde — ältere Tauchgänge wurden nicht heruntergeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronización se detuvo en la primera inmersión registrada antes del %@: no se descargaron las inmersiones más antiguas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation s'est arrêtée à la première plongée enregistrée avant le %@ — les plongées plus anciennes n'ont pas été téléchargées."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniseringen stoppet ved det første dykket registrert før %@ – eldre dykk ble ikke lastet ned."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie is gestopt bij de eerste duik die vóór %@ is vastgelegd — oudere duiken zijn niet gedownload."
          }
        }
      }
    },
    "The sync stops at the first dive recorded before the date you choose, so older dives are never transferred from the computer — a computer holding hundreds of dives you already logged syncs in the time its new dives take. Those older dives are not added to your logbook and, when re-downloading a known computer, not refreshed with the computer's data." : {
      "comment" : "A description of the date limit for Dive Computer Sync.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung endet beim ersten Tauchgang, der vor dem gewählten Datum aufgezeichnet wurde, sodass ältere Tauchgänge nie vom Computer gesendet werden — ein Computer mit Hunderten bereits erfasster Tauchgänge synchronisiert in der Zeit, die seine neuen Tauchgänge brauchen. Diese älteren Tauchgänge werden nicht zu deinem Logbuch hinzugefügt und beim erneuten Herunterladen eines bekannten Computers nicht mit dessen Daten aktualisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronización se detiene en la primera inmersión registrada antes de la fecha que elijas, por lo que las inmersiones más antiguas nunca se transfieren desde la computadora: una computadora con cientos de inmersiones ya registradas se sincroniza en el tiempo que tardan sus inmersiones nuevas. Esas inmersiones antiguas no se añaden a tu bitácora y, al volver a descargar una computadora conocida, no se actualizan con los datos de la computadora."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation s'arrête à la première plongée enregistrée avant la date choisie, de sorte que les plongées plus anciennes ne sont jamais transférées depuis l'ordinateur — un ordinateur contenant des centaines de plongées déjà consignées se synchronise dans le temps que prennent ses nouvelles plongées. Ces plongées plus anciennes ne sont pas ajoutées à votre carnet et, lors d'un nouveau téléchargement d'un ordinateur connu, ne sont pas actualisées avec les données de l'ordinateur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniseringen stopper ved det første dykket registrert før datoen du velger, så eldre dykk overføres aldri fra computeren – en computer med hundrevis av dykk du allerede har logget, synkroniseres på den tiden de nye dykkene tar. Disse eldre dykkene legges ikke til i loggboken og oppdateres ikke med computerens data når en kjent computer lastes ned på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie stopt bij de eerste duik die vóór de gekozen datum is vastgelegd, zodat oudere duiken nooit door de computer worden verstuurd — een computer met honderden duiken die je al hebt vastgelegd, synchroniseert in de tijd die de nieuwe duiken kosten. Die oudere duiken worden niet aan je logboek toegevoegd en bij het opnieuw downloaden van een bekende computer niet bijgewerkt met de gegevens van de computer."
          }
        }
      }
    },
    "The sync stops at the first dive recorded before this date — older dives are not downloaded or added to your logbook. The date defaults to the most recent dive in your logbook, or one year ago if your logbook is empty, and applies to this sync only. Has no effect on a device you've already synced." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung endet beim ersten Tauchgang, der vor diesem Datum aufgezeichnet wurde — ältere Tauchgänge werden weder heruntergeladen noch zu deinem Logbuch hinzugefügt. Das Datum wird standardmäßig auf den zuletzt erfassten Tauchgang in deinem Logbuch gesetzt, oder auf ein Jahr zuvor, wenn dein Logbuch leer ist, und gilt nur für diese Synchronisierung. Hat keine Auswirkung auf ein bereits synchronisiertes Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronización se detiene en la primera inmersión registrada antes de esta fecha: las inmersiones más antiguas no se descargan ni se añaden a tu bitácora. La fecha predeterminada es la de la inmersión más reciente de tu bitácora, o hace un año si tu bitácora está vacía, y se aplica solo a esta sincronización. No tiene efecto en un dispositivo que ya hayas sincronizado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation s'arrête à la première plongée enregistrée avant cette date — les plongées plus anciennes ne sont ni téléchargées ni ajoutées à votre carnet. La date correspond par défaut à la plongée la plus récente de votre carnet, ou à il y a un an si votre carnet est vide, et s'applique à cette synchronisation seulement. Sans effet sur un appareil déjà synchronisé."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniseringen stopper ved det første dykket registrert før denne datoen – eldre dykk lastes ikke ned eller legges til i loggboken. Datoen er som standard det nyeste dykket i loggboken din, eller ett år tilbake hvis loggboken er tom, og gjelder bare denne synkroniseringen. Har ingen virkning på en enhet du allerede har synkronisert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie stopt bij de eerste duik die vóór deze datum is vastgelegd — oudere duiken worden niet gedownload en niet aan je logboek toegevoegd. De datum wordt standaard ingesteld op de meest recente duik in je logboek, of op één jaar geleden als je logboek leeg is, en geldt alleen voor deze synchronisatie. Heeft geen effect op een apparaat dat je al hebt gesynchroniseerd."
          }
        }
      }
    },
    "The sync stops at the first dive recorded before this date — older dives are not downloaded, so they are neither re-imported nor updated. Applies to this sync only." : {
      "comment" : "A description of the sync cutoff.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung endet beim ersten Tauchgang, der vor diesem Datum aufgezeichnet wurde — ältere Tauchgänge werden nicht heruntergeladen und daher weder erneut importiert noch aktualisiert. Gilt nur für diese Synchronisierung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La sincronización se detiene en la primera inmersión registrada antes de esta fecha: las inmersiones más antiguas no se descargan, por lo que no se vuelven a importar ni se actualizan. Se aplica solo a esta sincronización."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation s'arrête à la première plongée enregistrée avant cette date — les plongées plus anciennes ne sont pas téléchargées, elles ne sont donc ni réimportées ni mises à jour. S'applique à cette synchronisation seulement."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Synkroniseringen stopper ved det første dykket registrert før denne datoen – eldre dykk lastes ikke ned, så de verken importeres på nytt eller oppdateres. Gjelder bare denne synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De synchronisatie stopt bij de eerste duik die vóór deze datum is vastgelegd — oudere duiken worden niet gedownload en dus niet opnieuw geïmporteerd of bijgewerkt. Geldt alleen voor deze synchronisatie."
          }
        }
      }
    },
