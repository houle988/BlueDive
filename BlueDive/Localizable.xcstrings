      }
    },
    "Total Gas (TG)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtgas (GG)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaz total (GT)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totaal gasvolume (TG)"
          }
        }
      }
    },
    "Total Gas (TG) is your total air when full. Usable Gas (UG) is what's left after subtracting the MG and the Reserve Gas (RG) — the air you can actually use during your dive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtgas (GG) ist dein gesamtes Luftvolumen bei voller Flasche. Nutzbares Gas (NG) ist das, was nach Abzug des MG und des Reservegases (RG) übrig bleibt — die Luft, die du während deines Tauchgangs tatsächlich nutzen kannst."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gaz total (GT) est la totalité de votre air à pleine pression. Le gaz utilisable (GU) est ce qui reste après soustraction du GM et du gaz de réserve (GR) — l'air que vous pouvez réellement utiliser durant votre plongée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het totale gasvolume (TG) is de totale hoeveelheid lucht wanneer de tank vol is. Het bruikbare gasvolume (BG) is wat er overblijft na aftrek van het MG en het reservegasvolume (RG) — de lucht die je daadwerkelijk tijdens je duik kunt gebruiken."
          }
        }
      }
    },
    "Total Time" : {
      "comment" : "Title for a statistic card displaying the total time spent using the gear.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
