    "\n… %lld more lines. Use Copy or Save As for full content." : {
      "comment" : "A note displayed below the UDDF preview, indicating that the content has been truncated and providing instructions on how to view the full content.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… %lld weitere Zeilen. Verwende „Kopieren“ oder „Speichern unter“ für den vollständigen Inhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… %lld more lines. Use Copy or Save As for full content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\n… %lld líneas más. Usa Copiar o Guardar como para ver el contenido completo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… %lld lignes de plus. Utilisez Copier ou Enregistrer sous pour le contenu complet."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\n… %lld linjer til. Bruk Kopier eller Arkiver som for å se hele innholdet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… nog %lld regels. Gebruik Kopiëren of Opslaan als voor de volledige inhoud."
          }
        }
      }
    },
    "–" : {
      "comment" : "A placeholder text for the minimum depth filter field.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    "—" : {
      "comment" : "A placeholder text used when a temperature reading is unavailable.",
      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
