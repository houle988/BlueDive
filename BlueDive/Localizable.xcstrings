    "Total Gas (TG)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtgas (GG)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Gas (TG)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gas total (TG)"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gaz total (GT)"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Total gass (TG)"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totaal gasvolume (TG)"
          }
        }
      }
    },
    "Total Gas (TG) is your total air when full. Usable Gas (UG) is what's left after subtracting the MG and the Reserve Gas (RG) — the air you can actually use during your dive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtgas (GG) ist dein gesamtes Luftvolumen bei voller Flasche. Nutzbares Gas (NG) ist das, was nach Abzug des MG und des Reservegases (RG) übrig bleibt — die Luft, die du während deines Tauchgangs tatsächlich nutzen kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Gas (TG) is your total air when full. Usable Gas (UG) is what's left after subtracting the MG and the Reserve Gas (RG) — the air you can actually use during your dive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El gas total (TG) es todo tu aire con la botella llena. El gas utilizable (UG) es lo que queda tras restar el MG y el gas de reserva (RG): el aire que realmente puedes usar durante la inmersión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gaz total (GT) est la totalité de votre air à pleine pression. Le gaz utilisable (GU) est ce qui reste après soustraction du GM et du gaz de réserve (GR) — l'air que vous pouvez réellement utiliser durant votre plongée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Total gass (TG) er all luften din når flasken er full. Brukbar gass (UG) er det som er igjen etter at MG og reservegassen (RG) er trukket fra – luften du faktisk kan bruke under dykket."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het totale gasvolume (TG) is de totale hoeveelheid lucht wanneer de tank vol is. Het bruikbare gasvolume (BG) is wat er overblijft na aftrek van het MG en het reservegasvolume (RG) — de lucht die je daadwerkelijk tijdens je duik kunt gebruiken."
          }
        }
      }
    },
