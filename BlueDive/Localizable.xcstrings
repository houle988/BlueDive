    "Choose System to follow your device's appearance (Settings → Display & Brightness), or override with Light or Dark. Switching from or to System will close Settings to apply the change." : {
      "comment" : "Appearance picker caption for iOS — includes note that switching from/to System closes Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle System, um das Erscheinungsbild deines Geräts zu übernehmen (Einstellungen → Anzeige & Helligkeit), oder überschreibe es mit Hell oder Dunkel. Ein Wechsel von oder zu System schließt die Einstellungen, um die Änderung anzuwenden."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Système pour suivre l'apparence de votre appareil (Réglages → Luminosité et affichage), ou sélectionnez Clair ou Sombre. Passer de ou vers Système fermera les Réglages pour appliquer le changement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Systeem om de weergave van je apparaat te volgen (Instellingen → Beeldscherm en helderheid), of gebruik Licht of Donker. Bij het wisselen van of naar Systeem worden de Instellingen gesloten om de wijziging toe te passen."
          }
        }
      }
    },
    "Choose System to follow your device's appearance (System Settings → Appearance), or override with Light or Dark. Switching from or to System will close Settings to apply the change." : {
      "comment" : "Appearance picker caption for macOS — includes note that switching from/to System closes Settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle System, um das Erscheinungsbild deines Geräts zu übernehmen (Systemeinstellungen → Erscheinungsbild), oder überschreibe es mit Hell oder Dunkel. Ein Wechsel von oder zu System schließt die Einstellungen, um die Änderung anzuwenden."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Système pour suivre l'apparence de votre appareil (Réglages du système → Apparence), ou sélectionnez Clair ou Sombre. Passer de ou vers Système fermera les Réglages pour appliquer le changement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Systeem om de weergave van je apparaat te volgen (Systeeminstellingen → Weergave), of gebruik Licht of Donker. Bij het wisselen van of naar Systeem worden de Instellingen gesloten om de wijziging toe te passen."
          }
        }
      }
    },
    "Choose System to use your device's language (Settings → General → Language & Region), or override with English, Français, Deutsch, or Nederlands. Switching from or to System will close Settings to apply the change." : {
      "comment" : "A description of the language picker.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle System, um die Gerätesprache zu verwenden (Einstellungen → Allgemein → Sprache & Region), oder überschreibe sie mit English, Français, Deutsch oder Nederlands. Ein Wechsel von oder zu System schließt die Einstellungen, um die Änderung anzuwenden."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Système pour utiliser la langue de votre appareil (Réglages → Général → Langue et région), ou remplacez par English, Français, Deutsch ou Nederlands. Passer de ou vers Système fermera les Réglages pour appliquer le changement."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies Systeem om de taal van je apparaat te gebruiken (Instellingen → Algemeen → Taal en regio), of gebruik English, Français, Deutsch of Nederlands. Bij het wisselen van of naar Systeem worden de Instellingen gesloten om de wijziging toe te passen."
          }
        }
      }
    },
    "Choose System to use your device's language (System Settings → General → Language & Region), or override with English, Français, Deutsch, or Nederlands. Switching from or to System will close Settings to apply the change." : {
