          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Velg System for å følge enhetens utseende (Systeminnstillinger → Utseende), eller overstyr med Lyst eller Mørkt. Hvis du bytter fra eller til System, lukkes Innstillinger for å bruke endringen."
