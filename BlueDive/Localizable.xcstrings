          }
        }
      }
    },
    "Gas density measures the mass of gas per unit volume (g/L) at a given pressure. As you descend, pressure increases and the gas you breathe becomes denser, making it harder to breathe and increasing the work of breathing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gasdichte misst die Masse des Gases pro Volumeneinheit (g/L) bei einem bestimmten Druck. Beim Abtauchen steigt der Druck und das eingeatmete Gas wird dichter, was das Atmen erschwert und die Atemarbeit erhöht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gas density measures the mass of gas per unit volume (g/L) at a given pressure. As you descend, pressure increases and the gas you breathe becomes denser, making it harder to breathe and increasing the work of breathing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La densidad del gas mide la masa de gas por unidad de volumen (g/L) a una presión dada. Al descender, la presión aumenta y el gas que respiras se vuelve más denso, lo que dificulta la respiración y aumenta el trabajo respiratorio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La densité de gaz mesure la masse de gaz par unité de volume (g/L) à une pression donnée. En descendant, la pression augmente et le gaz que vous respirez devient plus dense, ce qui rend la respiration plus difficile et augmente le travail respiratoire."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gasstetthet måler massen av gass per volumenhet (g/L) ved et gitt trykk. Når du går nedover, øker trykket, og gassen du puster inn blir tettere, noe som gjør det tyngre å puste og øker pustearbeidet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gasdichtheid geeft de massa van gas per volume-eenheid (g/L) bij een bepaalde druk weer. Naarmate je dieper duikt, neemt de druk toe en wordt het gas dat je inademt dichter, waardoor het moeilijker wordt om te ademen en de ademhalingsinspanning toeneemt."
          }
        }
      }
    },
    "Gas density within safe range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasdichte im sicheren Bereich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gas density within safe range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Densidad del gas dentro del rango seguro."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densité de gaz dans les limites sécuritaires."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gasstettheten er innenfor trygt område."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gasdichtheid ligt binnen het veilige bereik."
          }
        }
      }
    },
    "Gas fractions exceed %@. Adjust the mixture to calculate density." : {
      "localizations" : {
        "de" : {
