          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een factor van 1.5 betekent dat je plant voor %@ meer gasverbruik gedurende de opstijging. Deze buffer wordt toegepast bovenop de berekende MG, voordat het bruikbare gas wordt afgeleid."
          }
        }
      }
