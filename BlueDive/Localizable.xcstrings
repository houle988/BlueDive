    "\n… %lld more lines. Use Copy or Save As for full content." : {
      "comment" : "A note displayed below the UDDF preview, indicating that the content has been truncated and providing instructions on how to view the full content.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… %lld weitere Zeilen. Verwende „Kopieren“ oder „Speichern unter“ für den vollständigen Inhalt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… %lld lignes de plus. Utilisez Copier ou Enregistrer sous pour le contenu complet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n… nog %lld regels. Gebruik Kopiëren of Opslaan als voor de volledige inhoud."
