    "Permanently deletes all data from this device and iCloud. This action cannot be undone. Wait for iCloud sync to finish uploading before closing the app." : {
      "comment" : "Footer under the Erase All Data button in Data Management settings.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dauerhaft alle Daten von diesem Gerät und iCloud. Diese Aktion kann nicht rückgängig gemacht werden. Warte, bis der iCloud-Upload abgeschlossen ist, bevor du die App schließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes all data from this device and iCloud. This action cannot be undone. Wait for iCloud sync to finish uploading before closing the app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina de forma permanente todos los datos de este dispositivo y de iCloud. Esta acción no se puede deshacer. Espera a que la sincronización con iCloud termine de subir los datos antes de cerrar la app."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement toutes les données de cet appareil et d'iCloud. Cette action est irréversible. Attendez que la synchronisation iCloud termine l'envoi avant de fermer l'application."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sletter alle data permanent fra denne enheten og iCloud. Denne handlingen kan ikke angres. Vent til iCloud-synkroniseringen er ferdig med å laste opp før du lukker appen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert permanent alle gegevens van dit apparaat en iCloud. Deze actie kan niet ongedaan worden gemaakt. Wacht tot de iCloud-synchronisatie klaar is met uploaden voordat je de app sluit."
          }
        }
      }
    },
