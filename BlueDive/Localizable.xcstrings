          }
        }
      }
    },
    "All dives should be planned and conducted with proper training and certification from a recognized dive agency (e.g. PADI, SSI, NAUI, CMAS, BSAC, or equivalent)." : {
      "comment" : "A description of the disclaimer.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Tauchgänge sollten mit einer angemessenen Ausbildung und Zertifizierung einer anerkannten Tauchorganisation (z. B. PADI, SSI, NAUI, CMAS, VDST oder gleichwertig) geplant und durchgeführt werden."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les plongées doivent être planifiées et effectuées avec une formation et une certification appropriées d'un organisme de plongée reconnu (p. ex. PADI, SSI, NAUI, CMAS, BSAC, ou équivalent)."
          }
        }
      }
    },
    "All gear, groups, and tank templates in the file already exist." : {
      "comment" : "Alert message shown when a gear import (CSV or XML) completes but every item already exists in the database.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle Ausrüstungsgegenstände, Gruppen und Flaschenvorlagen in der Datei sind bereits vorhanden."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les équipements, groupes et modèles de cylindre du fichier existent déjà."
          }
        }
      }
