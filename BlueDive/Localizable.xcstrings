    },
    "* RMV derived from %@ + %@ using stored working pressure for cu ft → L conversion" : {
      "comment" : "Footnote explaining the `*` suffix on `formattedRMV` for when the RMV is displayed in psi instead of bar.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "* AMV abgeleitet aus %1$@ + %2$@ unter Verwendung des gespeicherten Betriebsdrucks für die Umrechnung cu ft → L"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
