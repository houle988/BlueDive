    "Nitrox diving requires specific training and equipment analysis. Always dive within your training and certification limits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitrox-Tauchen erfordert eine spezifische Ausbildung und Ausrüstungsanalyse. Tauche immer innerhalb deiner Ausbildungs- und Zertifizierungsgrenzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitrox diving requires specific training and equipment analysis. Always dive within your training and certification limits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El buceo con nitrox requiere formación específica y el análisis del equipo. Bucea siempre dentro de los límites de tu formación y certificación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La plongée au nitrox nécessite une formation spécifique et une analyse de l'équipement. Plongez toujours dans les limites de votre formation et de vos certifications."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nitroxdykking krever egen opplæring og analyse av utstyret. Dykk alltid innenfor grensene for opplæringen og sertifiseringen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor het duiken met nitrox zijn een specifieke opleiding en een controle van de duikuitrusting vereist. Duik altijd binnen de grenzen van je opleiding en brevet."
          }
        }
      }
    },
