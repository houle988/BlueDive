        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingen bilder av denne arten ennå. Bilder der bildeteksten eller nøkkelordene nevner denne arten, kan kobles når du importerer dem eller skanner bildene dine."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen foto van deze soort. Foto’s waarvan het bijschrift of de trefwoorden deze soort noemen, kunnen worden gekoppeld wanneer je ze importeert of je foto’s scant."
          }
        }
      }
    },
