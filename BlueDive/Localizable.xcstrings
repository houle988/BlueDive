    "Gas density measures the mass of gas per unit volume (g/L) at a given pressure. As you descend, pressure increases and the gas you breathe becomes denser, making it harder to breathe and increasing the work of breathing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gasdichte misst die Masse des Gases pro Volumeneinheit (g/L) bei einem bestimmten Druck. Beim Abtauchen steigt der Druck und das eingeatmete Gas wird dichter, was das Atmen erschwert und die Atemarbeit erhöht."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La densité de gaz mesure la masse de gaz par unité de volume (g/L) à une pression donnée. En descendant, la pression augmente et le gaz que vous respirez devient plus dense, ce qui rend la respiration plus difficile et augmente le travail respiratoire."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gasdichtheid geeft de massa van gas per volume-eenheid (g/L) bij een bepaalde druk weer. Naarmate je dieper duikt, neemt de druk toe en wordt het gas dat je inademt dichter, waardoor het moeilijker wordt om te ademen en de ademhalingsinspanning toeneemt."
          }
        }
      }
    },
    "Gas density within safe range." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasdichte im sicheren Bereich."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Densité de gaz dans les limites sécuritaires."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gasdichtheid ligt binnen het veilige bereik."
          }
        }
      }
    },
    "Gas fractions exceed %@. Adjust the mixture to calculate density." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gasanteile überschreiten %@. Passe die Mischung an, um die Dichte zu berechnen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fractions de gaz dépassent %@. Ajustez le mélange pour calculer la densité."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De gasfracties overschrijden %@. Pas het mengsel aan om de dichtheid te berekenen."
          }
        }
      }
    },
