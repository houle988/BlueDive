    "Automatically set the dive computer's clock to your device's current time and time zone after each sync." : {
      "comment" : "Footer text below the Sync device clock toggle in the Bluetooth sync screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt die Uhr des Tauchcomputers nach jeder Synchronisierung automatisch auf die aktuelle Uhrzeit und Zeitzone deines Geräts ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically set the dive computer's clock to your device's current time and time zone after each sync."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajusta automáticamente el reloj de la computadora de buceo a la hora y zona horaria actuales de tu dispositivo después de cada sincronización."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Règle automatiquement l'horloge de l'ordinateur de plongée à l'heure et au fuseau horaire de votre appareil après chaque synchronisation."
          }
        },
        "nb" : {
          "stringUnit" : {
