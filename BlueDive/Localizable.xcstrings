    "Best Mix" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestes Gemisch"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur mélange"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Mengsel"
          }
        }
      }
    },
    "Best Mix is the highest percentage of oxygen in a Nitrox blend that keeps the partial pressure of oxygen (ppO₂) at or below your target limit at a given depth. It maximises the no-decompression limit and reduces nitrogen narcosis while staying within your ppO₂ ceiling." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das beste Gemisch ist der höchste Sauerstoffanteil in einem Nitrox-Gemisch, der den Sauerstoffpartialdruck (ppO₂) bei einer bestimmten Tiefe auf oder unter deinem Ziellimit hält. Es maximiert die Nullzeit und reduziert die Stickstoffnarkose, während es innerhalb deiner ppO₂-Grenze bleibt."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le meilleur mélange est le pourcentage maximal d'oxygène dans un mélange Nitrox qui maintient la pression partielle d'oxygène (ppO₂) à la limite cible ou en dessous à une profondeur donnée. Il maximise la limite de non-décompression et réduit la narcose à l'azote tout en restant dans votre plafond de ppO₂."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het ‘Beste Mengsel’ is het hoogste zuurstofpercentage in een Nitrox-mengsel waarmee de partiële zuurstofdruk (ppO₂) op een bepaalde diepte op of onder je streefwaarde blijft. Het maximaliseert de niet-decompressielimiet en vermindert stikstofnarcose, terwijl je binnen je ppO₂-grens blijft."
          }
        }
      }
    },
    "Best Nitrox Mix" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestes Nitrox-Gemisch"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleur mélange Nitrox"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beste Nitroxmengsel"
          }
        }
      }
    },
