      "isCommentAutoGenerated" : true,
      "shouldTranslate" : false
    },
    ": %@" : {
      "comment" : "A label and its value in a row. The argument is the string “—”, the string “%1$arg-%2$arg”, the string “%1$arg-%2$arg %3$arg” or the string “%1$.0f-%2$.0f min”.",
