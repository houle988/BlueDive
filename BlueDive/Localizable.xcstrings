    "Best Dive" : {
      "comment" : "Label for the best dive in the trip details view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bester Tauchgang"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meilleure plongée"
          }
        }
      }
