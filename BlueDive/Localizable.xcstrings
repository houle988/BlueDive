    "Other names are used to recognise sightings and photo keywords written differently. Removing one does not change any sighting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weitere Namen dienen dazu, anders geschriebene Sichtungen und Foto-Stichwörter zu erkennen. Das Entfernen eines Namens ändert keine Sichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los otros nombres sirven para reconocer avistamientos y palabras clave de fotos escritos de otra forma. Eliminar uno no cambia ningún avistamiento."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les autres noms servent à reconnaître les observations et les mots-clés de photos écrits autrement. En retirer un ne modifie aucune observation."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Andre navn brukes til å gjenkjenne observasjoner og nøkkelord i bilder som er skrevet annerledes. Å fjerne et navn endrer ingen observasjon."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
