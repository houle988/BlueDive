    "The service pressure is used to convert the gas capacity (ft³) into actual water volume (L) for RMV and SAC calculations. Typical value: 3000 PSI." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Arbeitsdruck wird verwendet, um die Gaskapazität (ft³) für die RMV- und SAC-Berechnungen in das tatsächliche Wasservolumen (L) umzurechnen. Typischer Wert: 3000 PSI."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The service pressure is used to convert the gas capacity (ft³) into actual water volume (L) for RMV and SAC calculations. Typical value: 3000 PSI."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pression de service est utilisée pour convertir la capacité de gaz (pi³) en volume d'eau réel (L) pour les calculs VRM et SAC. Valeur typique : 3 000 PSI."
          }
        }
      }
    },
    "The UDDF export is automatically generated from internal data and cannot be edited." : {
