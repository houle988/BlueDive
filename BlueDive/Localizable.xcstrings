    "All calculations provided by this tool are estimates. It is the diver's sole responsibility to verify and validate all results before any dive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle von diesem Tool bereitgestellten Berechnungen sind Schätzungen. Es liegt in der alleinigen Verantwortung des Tauchers, alle Ergebnisse vor jedem Tauchgang zu überprüfen und zu validieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All calculations provided by this tool are estimates. It is the diver's sole responsibility to verify and validate all results before any dive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Todos los cálculos que ofrece esta herramienta son estimaciones. Es responsabilidad exclusiva del buceador verificar y validar todos los resultados antes de cualquier inmersión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les calculs fournis par cet outil sont des estimations. Il est de la seule responsabilité du plongeur de vérifier et valider tous les résultats avant toute plongée."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle beregninger fra dette verktøyet er estimater. Det er dykkerens eget ansvar å kontrollere og validere alle resultater før hvert dykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle berekeningen die deze tool oplevert, zijn schattingen. Het is de exclusieve verantwoordelijkheid van de duiker om alle resultaten vóór elke duik te controleren en te valideren."
          }
        }
      }
    },
    "All certifications have expired." : {
      "comment" : "Inline message shown in the Documents view Certifications tab when all certifications are expired.",
