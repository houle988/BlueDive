    "Gas Density Calculator" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasdichte-Rechner"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gas Density Calculator"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Calculadora de densidad del gas"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculateur de densité de gaz"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gasstetthetskalkulator"
          }
        },
        "nl" : {
