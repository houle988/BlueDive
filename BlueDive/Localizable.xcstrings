      }
    },
    "All data erased. Wait for iCloud sync to finish uploading before closing the app. Monitor the cloud icon on the main screen." : {
      "comment" : "Status message shown after all local and iCloud data has been erased. Instructs the user to wait for iCloud upload to complete before closing the app.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Daten gelöscht. Warte, bis der iCloud-Upload abgeschlossen ist, bevor du die App schließt. Beobachte das Wolkensymbol auf dem Hauptbildschirm."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données supprimées. Attendez la fin du téléversement iCloud avant de fermer l'app. Surveillez l'icône de nuage sur l'écran principal."
          }
        }
      }
    },
