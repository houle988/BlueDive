    "Download All Dives is on for this sync, carried over from the known-devices screen — it re-downloads the full history and merges matched dives. Turn it off from the main screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Tauchgänge herunterladen ist für diese Synchronisierung aktiviert, übernommen vom Bildschirm der bekannten Tauchcomputer — dadurch wird der gesamte Verlauf erneut heruntergeladen und übereinstimmende Tauchgänge werden zusammengeführt. Schalte die Option auf dem Hauptbildschirm aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Descargar todas las inmersiones» está activado para esta sincronización, heredado de la pantalla de dispositivos conocidos — vuelve a descargar todo el historial y combina las inmersiones coincidentes. Desactívalo desde la pantalla principal."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger toutes les plongées est activé pour cette synchronisation, reporté depuis l'écran des ordinateurs connus — cela retélécharge l'historique complet et fusionne les plongées correspondantes. Désactivez cette option depuis l'écran principal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Last ned alle dykk er slått på for denne synkroniseringen, overført fra skjermen for kjente enheter – den laster ned hele historikken på nytt og slår sammen samsvarende dykk. Slå det av fra hovedskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Alle duiken downloaden' staat aan voor deze synchronisatie, overgenomen van het scherm met bekende duikcomputers — hierdoor wordt de volledige geschiedenis opnieuw gedownload en worden overeenkomende duiken samengevoegd. Schakel deze uit via het hoofdscherm."
          }
        }
      }
    },
    "Download All Dives is only available for known dive computers. Sync this device once first, then use it from the main screen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Tauchgänge herunterladen ist nur für bekannte Tauchcomputer verfügbar. Synchronisiere dieses Gerät zunächst einmal, und verwende die Option dann vom Hauptbildschirm aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download All Dives is only available for known dive computers. Sync this device once first, then use it from the main screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "«Descargar todas las inmersiones» solo está disponible para computadoras de buceo conocidas. Sincroniza primero este dispositivo una vez y luego úsalo desde la pantalla principal."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger toutes les plongées n'est disponible que pour les ordinateurs connus. Synchronisez d'abord cet appareil, puis utilisez cette option depuis l'écran principal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Last ned alle dykk er bare tilgjengelig for kjente dykkecomputere. Synkroniser denne enheten én gang først, og bruk det deretter fra hovedskjermen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'Alle duiken downloaden' is alleen beschikbaar voor bekende duikcomputers. Synchroniseer dit apparaat eerst één keer en gebruik de functie vervolgens via het hoofdscherm."
          }
        }
      }
    },
