    "You are solely responsible for verifying all results before any dive. Never use these tools as the sole basis for dive planning or safety decisions." : {
      "comment" : "A warning displayed in the footer of the calculator.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist allein dafür verantwortlich, alle Ergebnisse vor jedem Tauchgang zu überprüfen. Verwende diese Werkzeuge niemals als alleinige Grundlage für die Tauchplanung oder Sicherheitsentscheidungen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes seul responsable de vérifier tous les résultats avant chaque plongée. N'utilisez jamais ces outils comme seule base pour la planification ou les décisions de sécurité en plongée."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent zelf volledig verantwoordelijk voor het controleren van alle resultaten vóór elke duik. Gebruik deze hulpmiddelen nooit als enige basis voor duikplanning of veiligheidsbeslissingen."
          }
        }
      }
    },
