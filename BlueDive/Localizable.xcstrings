    "All calculations provided by this tool are estimates. It is the diver's sole responsibility to verify and validate all results before any dive." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alle von diesem Tool bereitgestellten Berechnungen sind Schätzungen. Es liegt in der alleinigen Verantwortung des Tauchers, alle Ergebnisse vor jedem Tauchgang zu überprüfen und zu validieren."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les calculs fournis par cet outil sont des estimations. Il est de la seule responsabilité du plongeur de vérifier et valider tous les résultats avant toute plongée."
          }
        }
      }
    },
    "All certifications have expired." : {
      "comment" : "Inline message shown in the Documents view Certifications tab when all certifications are expired.",
      "localizations" : {
