    "Calculate the density of your breathing gas at depth. Colour-coded thresholds warn you when gas density may impair breathing and increase CO₂ retention risk." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berechne die Dichte deines Atemgases in der Tiefe. Farbcodierte Schwellenwerte warnen dich, wenn die Gasdichte die Atmung beeinträchtigen und das CO₂-Retentionsrisiko erhöhen kann."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculez la densité de votre gaz respiratoire en profondeur. Des seuils colorés vous avertissent lorsque la densité du gaz risque d'altérer la respiration et d'augmenter le risque de rétention de CO₂."
          }
        }
      }
    },
    "Calculate the minimum breathing gas needed to safely bring you and your buddy to the surface if either of you runs out of air at depth." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Berechne das Mindestmaß an Atemgas, das benötigt wird, um dich und deinen Tauchpartner sicher an die Oberfläche zu bringen, wenn einer von euch in der Tiefe die Luft ausgeht."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculez le gaz respiratoire minimum nécessaire pour ramener vous et votre binôme en surface en toute sécurité si l'un de vous manque d'air en profondeur."
          }
        }
      }
    },
