    "Total exceeds %@. Adjust the gas fractions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamt überschreitet %@. Passe die Gasanteile an."
          }
        },
