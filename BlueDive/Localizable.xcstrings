    "All results are mathematical estimates based on your inputs. They do not account for individual physiology, equipment variation, or real-world conditions." : {
      "comment" : "A description of the limitations of the dive calculator.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Ergebnisse sind mathematische Schätzungen basierend auf deinen Eingaben. Sie berücksichtigen keine individuelle Physiologie, Ausrüstungsunterschiede oder reale Bedingungen."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les résultats sont des estimations mathématiques basées sur vos entrées. Ils ne tiennent pas compte de la physiologie individuelle, des variations d'équipement ni des conditions réelles."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle resultaten zijn wiskundige schattingen op basis van de door jou ingevoerde gegevens. Er wordt geen rekening gehouden met individuele fysiologische kenmerken, verschillen in duikuitrusting of omstandigheden in de praktijk."
          }
        }
      }
    },
    "All rights reserved." : {
