      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle System, um die Gerätesprache zu verwenden (Einstellungen → Allgemein → Sprache & Region), oder überschreibe sie mit English, Français, Deutsch, Nederlands, Norsk bokmål oder Español. Ein Wechsel von oder zu System schließt die Einstellungen, um die Änderung anzuwenden."
